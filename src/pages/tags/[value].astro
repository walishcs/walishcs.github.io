---
import { BlogDirectory } from '@/components/BlogDirectory';
import PageHeader from '@/components/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getBlogTags,
  selectBlogPosts,
  type BlogDirectoryPost,
  type BlogTag,
} from '@/lib/blog-directory';
import { getPublishedPosts } from '@/lib/collections';
import { formatDate } from '@/lib/format';

export async function getStaticPaths() {
  const posts = (await getPublishedPosts()).map((entry) => ({
    href: `/blog/${entry.id}/`,
    title: entry.data.title,
    summary: entry.data.excerpt,
    publishedAt: entry.data.publishedAt,
    formattedDate: formatDate(entry.data.publishedAt),
    tags: entry.data.tags,
  }));
  const tags = getBlogTags(posts);
  return tags.map((tag) => ({
    params: { value: tag.value },
    props: { tag, tags, posts: selectBlogPosts(posts, { tag: tag.label }) },
  }));
}

interface Props {
  tag: BlogTag;
  tags: BlogTag[];
  posts: BlogDirectoryPost[];
}

const { tag, tags, posts } = Astro.props;
const description = `Blog posts tagged “${tag.label}”.`;
---

<BaseLayout title={`Tag: ${tag.label}`} description={description}>
  <PageHeader
    eyebrow="Writing"
    title={`Tag: ${tag.label}`}
    description={description}
  />
  <BlogDirectory posts={posts} tags={tags} activeTag={tag.label} client:load />
</BaseLayout>
