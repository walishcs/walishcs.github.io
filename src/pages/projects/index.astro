---
import { ContentCardGrid } from '@/components/ContentCardGrid';
import { EmptyState } from '@/components/EmptyState';
import PageHeader from '@/components/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProjects } from '@/lib/collections';
import { formatDateRange, labelFromSlug } from '@/lib/format';

const projects = await getProjects();
---

<BaseLayout
  title="Projects"
  description="Research, software, and collaborative projects."
>
  <PageHeader
    eyebrow="Work"
    title="Projects"
    description="Research, software, and collaborative projects."
  />
  {
    projects.length ? (
      <ContentCardGrid
        items={projects.map((entry) => ({
          href: `/projects/${entry.id}/`,
          title: entry.data.title,
          summary: entry.data.summary,
          meta: formatDateRange(entry.data.startDate, entry.data.endDate),
          badge: labelFromSlug(entry.data.status),
        }))}
      />
    ) : (
      <EmptyState
        title="No projects yet"
        message="Projects will appear here when they are added."
      />
    )
  }
</BaseLayout>
