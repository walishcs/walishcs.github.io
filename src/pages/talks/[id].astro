---
import { Link } from '@astryxdesign/core/Link';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTalks } from '@/lib/collections';
import { formatDate, labelFromSlug } from '@/lib/format';

export async function getStaticPaths() {
  const talks = await getTalks();
  return talks.map((talk) => ({
    params: { id: talk.id },
    props: { talk },
  }));
}

interface Props {
  talk: CollectionEntry<'talks'>;
}

const { talk } = Astro.props;
const { data } = talk;
const eventLocation = [data.event, data.location].filter(Boolean).join(' · ');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: data.title,
  startDate: data.date,
  description: data.abstract || undefined,
  performer: data.speakers.map((name) => ({ '@type': 'Person', name })),
  location: data.location || undefined,
};
---

<BaseLayout
  title={data.title}
  description={data.abstract || undefined}
  jsonLd={jsonLd}
>
  <article>
    <header class="detail-header">
      <p class="eyebrow">{labelFromSlug(data.type)}</p>
      <h1>{data.title}</h1>
      <p class="detail-summary">{data.speakers.join(', ')}</p>
      <p class="detail-meta">
        {formatDate(data.date)}{eventLocation && ` · ${eventLocation}`}
      </p>
      {
        data.links.length > 0 && (
          <ul class="detail-links" aria-label="Talk links">
            {data.links.map((link) => (
              <li>
                <Link
                  className="site-link"
                  href={link.url}
                  target="_blank"
                  rel="noreferrer"
                  hasUnderline
                >
                  {link.label}
                </Link>
              </li>
            ))}
          </ul>
        )
      }
    </header>
    {
      data.abstract && (
        <section class="prose" aria-labelledby="talk-abstract">
          <h2 id="talk-abstract">Abstract</h2>
          <p>{data.abstract}</p>
        </section>
      )
    }
  </article>
</BaseLayout>
