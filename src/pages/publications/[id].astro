---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { labelFromSlug } from '@/lib/format';
import { publicationYearLabel } from '@/lib/publication-utils';
import { Link } from '@astryxdesign/core/Link';

export async function getStaticPaths() {
  const publications = await getCollection('publications');
  return publications.map((publication) => ({
    params: { id: publication.id },
    props: { publication },
  }));
}

interface Props {
  publication: CollectionEntry<'publications'>;
}

const { publication } = Astro.props;
const { data } = publication;
const doiUrl = data.doi
  ? data.doi.startsWith('http')
    ? data.doi
    : `https://doi.org/${data.doi}`
  : null;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: data.title,
  author: data.authors.map((name) => ({ '@type': 'Person', name })),
  ...(typeof data.year === 'number'
    ? { datePublished: String(data.year) }
    : {}),
  isPartOf: data.venue || undefined,
  abstract: data.abstract || undefined,
  sameAs: doiUrl || undefined,
};
---

<BaseLayout
  title={data.title}
  description={data.abstract || undefined}
  jsonLd={jsonLd}
>
  <article>
    <header class="detail-header">
      <p class="eyebrow">{labelFromSlug(data.type)}</p>
      <h1>{data.title}</h1>
      <p class="detail-summary">{data.authors.join(', ')}</p>
      <p class="detail-meta">
        {publicationYearLabel(data.year)}{data.venue && ` · ${data.venue}`}
      </p>
      {
        (doiUrl || data.links.length > 0) && (
          <ul class="detail-links" aria-label="Publication links">
            {doiUrl && (
              <li>
                <Link
                  className="site-link"
                  href={doiUrl}
                  target="_blank"
                  rel="noreferrer"
                  hasUnderline
                >
                  DOI
                </Link>
              </li>
            )}
            {data.links.map((link) => (
              <li>
                <Link
                  className="site-link"
                  href={link.url}
                  target="_blank"
                  rel="noreferrer"
                  hasUnderline
                >
                  {link.label}
                </Link>
              </li>
            ))}
          </ul>
        )
      }
    </header>
    {
      data.abstract && (
        <section class="prose" aria-labelledby="abstract">
          <h2 id="abstract">Abstract</h2>
          <p>{data.abstract}</p>
        </section>
      )
    }
  </article>
</BaseLayout>
