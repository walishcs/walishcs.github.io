---
import { parseOutlineFromMarkdown } from '@astryxdesign/core/Outline';
import type { CollectionEntry } from 'astro:content';
import { BlogMarkdown } from '@/components/BlogMarkdown';
import { BlogOutline } from '@/components/BlogOutline';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { prepareBlogMarkdown } from '@/lib/blog-markdown';
import { getPublishedPosts } from '@/lib/collections';
import { formatDate } from '@/lib/format';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const body = prepareBlogMarkdown(post.body, post.data.title);
const contentId = 'blog-article-content';
const hasOutline = parseOutlineFromMarkdown(body).length > 0;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt || undefined,
  datePublished: post.data.publishedAt,
  image: post.data.cover || undefined,
  mainEntityOfPage: Astro.url.href,
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt || undefined}
  image={post.data.cover}
  jsonLd={jsonLd}
  searchCategory="Blog"
>
  <article class="blog-article-layout">
    <section class="blog-article-content" aria-label="Article content">
      <header class="detail-header">
        <p class="eyebrow">Writing</p>
        <h1 class="detail-title">{post.data.title}</h1>
        <time class="detail-meta" datetime={post.data.publishedAt}>
          {formatDate(post.data.publishedAt)}
        </time>
        {post.data.excerpt && <p class="detail-summary">{post.data.excerpt}</p>}
        {
          post.data.tags.length > 0 && (
            <ul class="tag-list" aria-label="Tags">
              {post.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
      </header>
      {
        post.data.cover && (
          <img class="detail-cover" src={post.data.cover} alt="" />
        )
      }
      <section id={contentId} aria-label="Article body">
        <BlogMarkdown body={body} />
      </section>
    </section>
    {
      hasOutline && (
        <aside class="blog-outline-panel" data-pagefind-ignore>
          <BlogOutline body={body} contentId={contentId} client:load />
        </aside>
      )
    }
  </article>
</BaseLayout>
