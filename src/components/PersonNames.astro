---
import { isDefaultPersonName, withDefaultPersonName } from '@/lib/person-names';

interface Props {
  names: string[];
  defaultName?: string;
}

const { names, defaultName = '' } = Astro.props;
const displayNames = withDefaultPersonName(names, defaultName);
---

{
  displayNames.map((name, index) => (
    <>
      {index > 0 && ', '}
      {isDefaultPersonName(name, defaultName) ? <strong>{name}</strong> : name}
    </>
  ))
}
