---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getProjects } from '@/lib/collections';
import { formatDateRange, labelFromSlug } from '@/lib/format';
import { Link } from '@astryxdesign/core/Link';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const dateRange = formatDateRange(project.data.startDate, project.data.endDate);
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary || undefined}
  image={project.data.cover}
  searchCategory="Project"
>
  <article>
    <header class="detail-header">
      <p class="eyebrow">{labelFromSlug(project.data.status)} project</p>
      <h1 class="detail-title">{project.data.title}</h1>
      {dateRange && <p class="detail-meta">{dateRange}</p>}
      {
        project.data.summary && (
          <p class="detail-summary">{project.data.summary}</p>
        )
      }
      {
        project.data.links.length > 0 && (
          <ul class="detail-links" aria-label="Project links">
            {project.data.links.map((link) => (
              <li>
                <Link
                  className="site-link"
                  href={link.url}
                  target="_blank"
                  rel="noreferrer"
                  hasUnderline
                >
                  {link.label}
                </Link>
              </li>
            ))}
          </ul>
        )
      }
    </header>
    {
      project.data.cover && (
        <img class="detail-cover" src={project.data.cover} alt="" />
      )
    }
    <div class="prose"><Content /></div>
  </article>
</BaseLayout>
