---
import { EmptyState } from '@/components/EmptyState';
import PageHeader from '@/components/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublicationsByYear } from '@/lib/collections';
import { labelFromSlug } from '@/lib/format';

const groups = await getPublicationsByYear();
const years = Object.keys(groups)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout
  title="Publications"
  description="Peer-reviewed research and scholarly outputs."
>
  <PageHeader
    eyebrow="Research"
    title="Publications"
    description="Peer-reviewed research and scholarly outputs."
  />
  {
    years.length ? (
      years.map((year) => (
        <section class="year-group" aria-labelledby={`year-${year}`}>
          <h2 class="year-heading" id={`year-${year}`}>
            {year}
          </h2>
          <ol class="publication-list">
            {groups[year].map((entry) => (
              <li class="publication-item">
                <p class="publication-meta">{labelFromSlug(entry.data.type)}</p>
                <div class="publication-copy">
                  <h2>
                    <a href={`/publications/${entry.id}/`}>
                      {entry.data.title}
                    </a>
                  </h2>
                  <p>{entry.data.authors.join(', ')}</p>
                  {entry.data.venue && (
                    <p class="publication-meta">{entry.data.venue}</p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))
    ) : (
      <EmptyState
        title="No publications yet"
        message="Publications will appear here after they are added."
      />
    )
  }
</BaseLayout>
