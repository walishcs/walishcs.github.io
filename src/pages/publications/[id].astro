---
import { getCollection, type CollectionEntry } from 'astro:content';
import InlineEmphasis from '@/components/InlineEmphasis.astro';
import PersonNames from '@/components/PersonNames.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { labelFromSlug } from '@/lib/format';
import { formatPersonName, resolvePersonNames } from '@/lib/person-names';
import { publicationYearLabel } from '@/lib/publication-utils';
import { getSiteSettings } from '@/lib/site-content';
import { Link } from '@astryxdesign/core/Link';

export async function getStaticPaths() {
  const publications = await getCollection('publications');
  return publications.map((publication) => ({
    params: { id: publication.id },
    props: { publication },
  }));
}

interface Props {
  publication: CollectionEntry<'publications'>;
}

const { publication } = Astro.props;
const { data } = publication;
const settings = await getSiteSettings();
const authors = resolvePersonNames(
  data.authors,
  settings.defaultContributorName,
  data.defaultContributorPosition,
);
const doiUrl = data.doi
  ? data.doi.startsWith('http')
    ? data.doi
    : `https://doi.org/${data.doi}`
  : null;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: data.title,
  author: authors.map((name) => ({
    '@type': 'Person',
    name: formatPersonName(name, 1),
  })),
  ...(typeof data.year === 'number'
    ? { datePublished: String(data.year) }
    : {}),
  isPartOf: data.venue || undefined,
  abstract: data.abstract || undefined,
  sameAs: doiUrl || undefined,
};
---

<BaseLayout
  title={data.title}
  description={data.abstract || undefined}
  jsonLd={jsonLd}
  searchCategory="Publication"
>
  <article>
    <header class="detail-header">
      <p class="eyebrow">{labelFromSlug(data.type)}</p>
      <h1 class="detail-title">{data.title}</h1>
      <p class="detail-summary">
        <PersonNames
          names={data.authors}
          defaultName={settings.defaultContributorName}
          position={data.defaultContributorPosition}
        />
      </p>
      <p class="detail-meta">
        {publicationYearLabel(data.year)}
        {
          data.venue && (
            <>
              {' · '}
              <InlineEmphasis value={data.venue} />
            </>
          )
        }
      </p>
      {
        (doiUrl || data.links.length > 0) && (
          <ul class="detail-links" aria-label="Publication links">
            {doiUrl && (
              <li>
                <Link
                  className="site-link"
                  href={doiUrl}
                  target="_blank"
                  rel="noreferrer"
                  hasUnderline
                >
                  DOI
                </Link>
              </li>
            )}
            {data.links.map((link) => (
              <li>
                <Link
                  className="site-link"
                  href={link.url}
                  target="_blank"
                  rel="noreferrer"
                  hasUnderline
                >
                  {link.label}
                </Link>
              </li>
            ))}
          </ul>
        )
      }
    </header>
    {
      data.abstract && (
        <section class="prose" aria-labelledby="abstract">
          <h2 id="abstract">Abstract</h2>
          <p>{data.abstract}</p>
        </section>
      )
    }
  </article>
</BaseLayout>
