---
import { BlogDirectory } from '@/components/BlogDirectory';
import { EmptyState } from '@/components/EmptyState';
import PageHeader from '@/components/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPosts } from '@/lib/collections';
import { getBlogTags } from '@/lib/blog-directory';
import { formatDate } from '@/lib/format';

const posts = (await getPublishedPosts()).map((entry) => ({
  href: `/blog/${entry.id}/`,
  title: entry.data.title,
  summary: entry.data.excerpt,
  publishedAt: entry.data.publishedAt,
  formattedDate: formatDate(entry.data.publishedAt),
  tags: entry.data.tags,
}));
---

<BaseLayout
  title="Blog"
  description="Essays, notes, and updates on research and practice."
>
  <PageHeader
    eyebrow="Writing"
    title="Blog"
    description="Essays, notes, and updates on research and practice."
  />
  {
    posts.length ? (
      <BlogDirectory posts={posts} tags={getBlogTags(posts)} client:load />
    ) : (
      <EmptyState
        title="No published posts yet"
        message="Writing will appear here when published."
      />
    )
  }
</BaseLayout>
