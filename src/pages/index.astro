---
import { ContentCardGrid } from '@/components/ContentCardGrid';
import { EmptyState } from '@/components/EmptyState';
import { Hero } from '@/components/Hero';
import { NewsFeed } from '@/components/NewsFeed';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Link } from '@astryxdesign/core/Link';
import {
  getFeaturedProjects,
  getFeaturedPublications,
  getNews,
  getPublishedPosts,
} from '@/lib/collections';
import { formatDate, formatDateRange, labelFromSlug } from '@/lib/format';
import { publicationYearLabel } from '@/lib/publication-utils';
import { getHomeContent, getSiteSettings } from '@/lib/site-content';

const [home, settings, publications, projects, posts, news] = await Promise.all(
  [
    getHomeContent(),
    getSiteSettings(),
    getFeaturedPublications(),
    getFeaturedProjects(),
    getPublishedPosts(),
    getNews(),
  ],
);

const primary =
  home.primaryCtaLabel && home.primaryCtaUrl
    ? { label: home.primaryCtaLabel, href: home.primaryCtaUrl }
    : undefined;
const secondary =
  home.secondaryCtaLabel && home.secondaryCtaUrl
    ? { label: home.secondaryCtaLabel, href: home.secondaryCtaUrl }
    : undefined;
---

<BaseLayout>
  <Hero
    eyebrow={home.eyebrow}
    heading={home.heading}
    introduction={home.introduction}
    portrait={home.portrait}
    portraitAlt={`${settings.name} portrait`}
    primary={primary}
    secondary={secondary}
  />

  {
    home.showFeaturedPublications &&
      settings.showPublicationsPage !== false && (
        <section
          class="content-section"
          aria-labelledby="featured-publications"
        >
          <div class="section-heading">
            <h2 id="featured-publications">Featured publications</h2>
            <Link className="site-link" href="/publications/" hasUnderline>
              View all
            </Link>
          </div>
          {publications.length ? (
            <ContentCardGrid
              items={publications.map((entry) => ({
                href: `/publications/${entry.id}/`,
                title: entry.data.title,
                summary: entry.data.abstract,
                meta: `${publicationYearLabel(entry.data.year)}${entry.data.venue ? ` · ${entry.data.venue}` : ''}`,
                badge: labelFromSlug(entry.data.type),
              }))}
            />
          ) : (
            <EmptyState
              title="No featured publications yet"
              message="Featured research will appear here when it is added."
            />
          )}
        </section>
      )
  }

  {
    home.showFeaturedProjects && settings.showProjectsPage !== false && (
      <section class="content-section" aria-labelledby="featured-projects">
        <div class="section-heading">
          <h2 id="featured-projects">Featured projects</h2>
          <Link className="site-link" href="/projects/" hasUnderline>
            View all
          </Link>
        </div>
        {projects.length ? (
          <ContentCardGrid
            items={projects.map((entry) => ({
              href: `/projects/${entry.id}/`,
              title: entry.data.title,
              summary: entry.data.summary,
              meta: formatDateRange(entry.data.startDate, entry.data.endDate),
              badge: labelFromSlug(entry.data.status),
            }))}
          />
        ) : (
          <EmptyState
            title="No featured projects yet"
            message="Featured projects will appear here when they are added."
          />
        )}
      </section>
    )
  }

  {
    home.showLatestPosts && settings.showBlogPage !== false && (
      <section class="content-section" aria-labelledby="latest-posts">
        <div class="section-heading">
          <h2 id="latest-posts">Latest writing</h2>
          <Link className="site-link" href="/blog/" hasUnderline>
            View all
          </Link>
        </div>
        {posts.length ? (
          <ContentCardGrid
            items={posts.slice(0, 3).map((entry) => ({
              href: `/blog/${entry.id}/`,
              title: entry.data.title,
              summary: entry.data.excerpt,
              meta: formatDate(entry.data.publishedAt),
              badge: entry.data.tags[0],
            }))}
          />
        ) : (
          <EmptyState
            title="No published posts yet"
            message="Published writing will appear here when it is ready."
          />
        )}
      </section>
    )
  }

  {
    home.showNews && (
      <section class="content-section" aria-labelledby="latest-news">
        <div class="section-heading">
          <h2 id="latest-news">News</h2>
        </div>
        {news.length ? (
          <NewsFeed
            items={news.map((entry) => ({
              id: entry.id,
              title: entry.data.title,
              date: entry.data.date,
              summary: entry.data.summary,
              url: entry.data.url,
            }))}
            client:load
          />
        ) : (
          <EmptyState
            title="No news yet"
            message="Updates will appear here when available."
          />
        )}
      </section>
    )
  }
</BaseLayout>
